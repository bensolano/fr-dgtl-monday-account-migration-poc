# Google Cloud Settings
PROJECT_ID=sandbox-bsolano
REGION=europe-west1
REPORTS_BUCKET=sandbox-bsolano-migration-reports

# The name of the discovery job in Cloud Run (required for API to spawn jobs)
DISCOVERY_JOB_NAME=migration-discovery-job

# The URL of the worker service (used when spawning Cloud Tasks)
SERVICE_URL=http://localhost:8000

# Note: K_SERVICE is intentionally omitted here. When running locally without K_SERVICE,
# the app defaults to local execution mode (mocking Cloud Tasks with asyncio).
