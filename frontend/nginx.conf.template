server {
    listen       ${PORT};
    server_name  localhost;

    # Proxy API requests to the backend Cloud Run service
    location /api/ {
        proxy_pass ${API_URL};
        proxy_ssl_server_name on; # Required for Cloud Run HTTPS routing
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }

    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
